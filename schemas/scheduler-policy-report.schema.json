{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/harzva/codexhome-manager/schemas/scheduler-policy-report.schema.json",
  "title": "CodexHome Scheduler Policy Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ok",
    "schemaVersion",
    "policyPath",
    "policyId",
    "revision",
    "maxActiveJobs",
    "defaultHomeConcurrency",
    "defaultModelConcurrency",
    "homeOverrideCount",
    "modelOverrideCount",
    "maxLeaseMs",
    "safety"
  ],
  "properties": {
    "ok": { "const": true },
    "schemaVersion": { "const": "codexhome.scheduler-policy-report.v1" },
    "policyPath": { "type": "string", "minLength": 1 },
    "policyId": { "$ref": "observability-event.schema.json#/$defs/identifier" },
    "revision": { "type": "integer", "minimum": 0 },
    "maxActiveJobs": { "type": "integer", "minimum": 1 },
    "defaultHomeConcurrency": { "type": "integer", "minimum": 1 },
    "defaultModelConcurrency": { "type": "integer", "minimum": 1 },
    "homeOverrideCount": { "type": "integer", "minimum": 0 },
    "modelOverrideCount": { "type": "integer", "minimum": 0 },
    "maxLeaseMs": { "type": "integer", "minimum": 1 },
    "safety": { "$ref": "scheduler-report.schema.json#/$defs/safety" }
  }
}
