{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/harzva/codexhome-manager/schemas/agent-household.schema.json",
  "title": "CodexHome Agent Household Manifest",
  "description": "An orchestration policy over Expert Packs and hard-isolated Effective Runtimes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "label",
    "expertPackIds",
    "members",
    "policy"
  ],
  "properties": {
    "schemaVersion": { "const": "codexhome.household.v2alpha1" },
    "id": { "$ref": "account-profile.schema.json#/$defs/id" },
    "label": { "type": "string", "minLength": 1, "maxLength": 160 },
    "expertPackIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "account-profile.schema.json#/$defs/id" }
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "expertPackIds"],
        "properties": {
          "role": { "enum": ["planner", "executor", "tester", "reviewer"] },
          "expertPackIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "account-profile.schema.json#/$defs/id" }
          },
          "maxParallel": { "type": "integer", "minimum": 1, "maximum": 16 }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "isolation",
        "maxDepth",
        "requireReview",
        "credentialPropagation",
        "separateSessionState",
        "separateCostAttribution"
      ],
      "properties": {
        "isolation": { "const": "hard" },
        "maxDepth": { "const": 2 },
        "requireReview": { "type": "boolean" },
        "credentialPropagation": { "const": false },
        "separateSessionState": { "const": true },
        "separateCostAttribution": { "const": true }
      }
    }
  }
}
