{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/harzva/codexhome-manager/schemas/observability-event.schema.json",
  "title": "CodexHome Observability Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "timestampMs",
    "eventType",
    "status",
    "trace",
    "identity",
    "safety"
  ],
  "properties": {
    "schemaVersion": { "const": "codexhome.observability-event.v1" },
    "eventId": { "$ref": "#/$defs/identifier" },
    "timestampMs": { "type": "integer", "minimum": 0 },
    "eventType": {
      "enum": [
        "task_created",
        "run_started",
        "attempt_started",
        "worktree_prepared",
        "worktree_evidence_recorded",
        "worktree_review_recorded",
        "worktree_conflict_checked",
        "scheduler_job_queued",
        "scheduler_dispatch_decided",
        "scheduler_dispatch_deferred",
        "scheduler_job_paused",
        "scheduler_job_resumed",
        "scheduler_job_cancelled",
        "scheduler_job_timed_out",
        "scheduler_lease_renewed",
        "scheduler_recovery_required",
        "scheduler_recovery_resolved",
        "attempt_completed",
        "attempt_failed",
        "thread_linked",
        "tool_call_completed",
        "artifact_created",
        "verification_completed",
        "route_decided",
        "run_completed",
        "run_failed",
        "quota_snapshot",
        "rate_limited",
        "auth_invalid",
        "home_health"
      ]
    },
    "status": {
      "enum": [
        "started",
        "running",
        "succeeded",
        "failed",
        "cancelled",
        "timed_out",
        "retried",
        "degraded",
        "healthy",
        "unhealthy"
      ]
    },
    "trace": { "$ref": "#/$defs/trace" },
    "identity": { "$ref": "#/$defs/identity" },
    "usage": { "$ref": "#/$defs/usage" },
    "parentEventId": {
      "oneOf": [
        { "$ref": "#/$defs/identifier" },
        { "type": "null" }
      ]
    },
    "toolName": { "$ref": "#/$defs/nullableLabel" },
    "artifactKind": { "$ref": "#/$defs/nullableLabel" },
    "verificationKind": { "$ref": "#/$defs/nullableLabel" },
    "failure": {
      "oneOf": [
        { "$ref": "#/$defs/failure" },
        { "type": "null" }
      ]
    },
    "health": {
      "oneOf": [
        { "$ref": "#/$defs/health" },
        { "type": "null" }
      ]
    },
    "details": { "$ref": "#/$defs/details" },
    "safety": { "$ref": "#/$defs/safety" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9._:/@-]+$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "nullableLabel": {
      "oneOf": [
        { "$ref": "#/$defs/label" },
        { "type": "null" }
      ]
    },
    "nullableIdentifier": {
      "oneOf": [
        { "$ref": "#/$defs/identifier" },
        { "type": "null" }
      ]
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "taskId": { "$ref": "#/$defs/nullableIdentifier" },
        "runId": { "$ref": "#/$defs/nullableIdentifier" },
        "attemptId": { "$ref": "#/$defs/nullableIdentifier" },
        "threadId": { "$ref": "#/$defs/nullableIdentifier" },
        "parentThreadId": { "$ref": "#/$defs/nullableIdentifier" },
        "forkId": { "$ref": "#/$defs/nullableIdentifier" }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "homeId": { "$ref": "#/$defs/nullableIdentifier" },
        "homeAlias": { "$ref": "#/$defs/nullableLabel" },
        "accountId": { "$ref": "#/$defs/nullableIdentifier" },
        "provider": { "$ref": "#/$defs/nullableLabel" },
        "model": { "$ref": "#/$defs/nullableLabel" },
        "agentRole": { "$ref": "#/$defs/nullableLabel" }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inputTokens": { "type": "integer", "minimum": 0 },
        "outputTokens": { "type": "integer", "minimum": 0 },
        "cachedInputTokens": { "type": "integer", "minimum": 0 },
        "cacheHits": { "type": "integer", "minimum": 0 },
        "cacheMisses": { "type": "integer", "minimum": 0 },
        "durationMs": { "type": "integer", "minimum": 0 },
        "estimatedCostMicrousd": { "type": "integer", "minimum": 0 },
        "retries": { "type": "integer", "minimum": 0 }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "reason"],
      "properties": {
        "code": { "$ref": "#/$defs/label" },
        "phase": { "$ref": "#/$defs/nullableLabel" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "retryable": { "type": "boolean" }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["serviceReachable"],
      "properties": {
        "serviceReachable": { "type": "boolean" },
        "authValid": {
          "type": ["boolean", "null"]
        },
        "quotaRemainingBasisPoints": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 10000
        },
        "rateLimitResetAtMs": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "detailCode": { "$ref": "#/$defs/nullableLabel" }
      }
    },
    "details": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "task": {
          "oneOf": [
            { "$ref": "#/$defs/taskDescriptor" },
            { "type": "null" }
          ]
        },
        "budget": {
          "oneOf": [
            { "$ref": "#/$defs/runBudget" },
            { "type": "null" }
          ]
        },
        "routeReason": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 2048
        },
        "routeDecisionId": { "$ref": "#/$defs/nullableIdentifier" },
        "routing": {
          "oneOf": [
            { "$ref": "#/$defs/routeDecisionDetails" },
            { "type": "null" }
          ]
        },
        "transition": {
          "oneOf": [
            { "$ref": "#/$defs/attemptTransition" },
            { "type": "null" }
          ]
        },
        "worktree": {
          "oneOf": [
            { "$ref": "#/$defs/worktreePrepared" },
            { "type": "null" }
          ]
        },
        "worktreeEvidence": {
          "oneOf": [
            { "$ref": "#/$defs/worktreeEvidence" },
            { "type": "null" }
          ]
        },
        "worktreeReview": {
          "oneOf": [
            { "$ref": "#/$defs/worktreeReview" },
            { "type": "null" }
          ]
        },
        "worktreeConflict": {
          "oneOf": [
            { "$ref": "#/$defs/worktreeConflict" },
            { "type": "null" }
          ]
        },
        "schedulerJob": {
          "oneOf": [
            { "$ref": "scheduler-job.schema.json" },
            { "type": "null" }
          ]
        },
        "schedulerDispatch": {
          "oneOf": [
            { "$ref": "#/$defs/schedulerDispatch" },
            { "type": "null" }
          ]
        },
        "schedulerDeferred": {
          "oneOf": [
            { "$ref": "#/$defs/schedulerDeferred" },
            { "type": "null" }
          ]
        },
        "schedulerStateChange": {
          "oneOf": [
            { "$ref": "#/$defs/schedulerStateChange" },
            { "type": "null" }
          ]
        },
        "schedulerLease": {
          "oneOf": [
            { "$ref": "#/$defs/schedulerLease" },
            { "type": "null" }
          ]
        },
        "artifactId": { "$ref": "#/$defs/nullableIdentifier" },
        "verificationId": { "$ref": "#/$defs/nullableIdentifier" },
        "targetArtifactId": { "$ref": "#/$defs/nullableIdentifier" },
        "finalArtifactIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "taskDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {
        "label": { "$ref": "#/$defs/label" },
        "kind": { "$ref": "#/$defs/nullableLabel" }
      }
    },
    "runBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxTotalTokens": { "type": ["integer", "null"], "minimum": 1 },
        "maxDurationMs": { "type": ["integer", "null"], "minimum": 1 },
        "maxCostMicrousd": { "type": ["integer", "null"], "minimum": 1 },
        "maxAttempts": { "type": ["integer", "null"], "minimum": 1 }
      },
      "anyOf": [
        {
          "required": ["maxTotalTokens"],
          "properties": { "maxTotalTokens": { "type": "integer", "minimum": 1 } }
        },
        {
          "required": ["maxDurationMs"],
          "properties": { "maxDurationMs": { "type": "integer", "minimum": 1 } }
        },
        {
          "required": ["maxCostMicrousd"],
          "properties": { "maxCostMicrousd": { "type": "integer", "minimum": 1 } }
        },
        {
          "required": ["maxAttempts"],
          "properties": { "maxAttempts": { "type": "integer", "minimum": 1 } }
        }
      ]
    },
    "attemptTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["initial", "retry", "migration"] },
        "fromAttemptId": { "$ref": "#/$defs/nullableIdentifier" }
      }
    },
    "localPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "worktreePrepared": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositoryRoot",
        "worktreePath",
        "branch",
        "baseRef",
        "baseCommit",
        "headCommit"
      ],
      "properties": {
        "repositoryRoot": { "$ref": "#/$defs/localPath" },
        "worktreePath": { "$ref": "#/$defs/localPath" },
        "branch": { "$ref": "#/$defs/label" },
        "baseRef": { "$ref": "#/$defs/label" },
        "baseCommit": { "$ref": "#/$defs/gitCommit" },
        "headCommit": { "$ref": "#/$defs/gitCommit" }
      }
    },
    "worktreeEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceId",
        "baseCommit",
        "headCommit",
        "commitCount",
        "diffSha256",
        "patchPath",
        "patchBytes",
        "changedFiles",
        "insertions",
        "deletions",
        "worktreeClean",
        "testsSucceeded",
        "testLabel",
        "testExitCode",
        "testDurationMs",
        "testOutputSha256",
        "testLogPath"
      ],
      "properties": {
        "evidenceId": { "$ref": "#/$defs/identifier" },
        "baseCommit": { "$ref": "#/$defs/gitCommit" },
        "headCommit": { "$ref": "#/$defs/gitCommit" },
        "commitCount": { "type": "integer", "minimum": 1 },
        "diffSha256": { "$ref": "#/$defs/sha256" },
        "patchPath": { "$ref": "#/$defs/localPath" },
        "patchBytes": { "type": "integer", "minimum": 1 },
        "changedFiles": { "type": "integer", "minimum": 1 },
        "insertions": { "type": "integer", "minimum": 0 },
        "deletions": { "type": "integer", "minimum": 0 },
        "worktreeClean": { "type": "boolean" },
        "testsSucceeded": { "type": "boolean" },
        "testLabel": { "$ref": "#/$defs/label" },
        "testExitCode": { "type": "integer" },
        "testDurationMs": { "type": "integer", "minimum": 0 },
        "testOutputSha256": { "$ref": "#/$defs/sha256" },
        "testLogPath": { "$ref": "#/$defs/localPath" }
      }
    },
    "worktreeReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewId", "evidenceId", "decision", "reason"],
      "properties": {
        "reviewId": { "$ref": "#/$defs/identifier" },
        "evidenceId": { "$ref": "#/$defs/identifier" },
        "decision": {
          "enum": ["approved", "changes_requested", "rejected"]
        },
        "reason": { "type": "string", "minLength": 1, "maxLength": 2048 }
      }
    },
    "worktreeConflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkId",
        "evidenceId",
        "targetRef",
        "targetCommit",
        "headCommit",
        "conflictFree",
        "disposition",
        "conflictingPathsCount",
        "conflictsSha256"
      ],
      "properties": {
        "checkId": { "$ref": "#/$defs/identifier" },
        "evidenceId": { "$ref": "#/$defs/identifier" },
        "targetRef": { "$ref": "#/$defs/label" },
        "targetCommit": { "$ref": "#/$defs/gitCommit" },
        "headCommit": { "$ref": "#/$defs/gitCommit" },
        "conflictFree": { "type": "boolean" },
        "disposition": {
          "enum": ["none", "human_required", "replan_requested"]
        },
        "conflictingPathsCount": { "type": "integer", "minimum": 0 },
        "conflictsSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "schedulerSelectionMode": {
      "enum": ["dynamic", "preferred", "fallback"]
    },
    "schedulerDeferredCode": {
      "enum": [
        "dependency_pending",
        "dependency_failed",
        "not_before",
        "deadline_expired",
        "run_not_ready",
        "budget_exhausted",
        "dispatch_limit",
        "failure_threshold",
        "global_concurrency",
        "home_concurrency",
        "model_concurrency",
        "no_eligible_route",
        "active_attempt",
        "recovery_required"
      ]
    },
    "schedulerDispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jobId",
        "dispatchId",
        "dispatchOrdinal",
        "attemptId",
        "routeDecisionId",
        "leaseId",
        "leasedAtMs",
        "leaseExpiresAtMs",
        "selectedCandidateId",
        "selectionMode",
        "schedulerRejections"
      ],
      "properties": {
        "jobId": { "$ref": "#/$defs/identifier" },
        "dispatchId": { "$ref": "#/$defs/identifier" },
        "dispatchOrdinal": { "type": "integer", "minimum": 1 },
        "attemptId": { "$ref": "#/$defs/identifier" },
        "routeDecisionId": { "$ref": "#/$defs/identifier" },
        "leaseId": { "$ref": "#/$defs/identifier" },
        "leasedAtMs": { "type": "integer", "minimum": 0 },
        "leaseExpiresAtMs": { "type": "integer", "minimum": 0 },
        "selectedCandidateId": { "$ref": "#/$defs/identifier" },
        "selectionMode": { "$ref": "#/$defs/schedulerSelectionMode" },
        "schedulerRejections": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 2048 }
        }
      }
    },
    "schedulerDeferred": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jobId",
        "decisionId",
        "code",
        "reason",
        "nextEligibleAtMs",
        "routeDecisionId"
      ],
      "properties": {
        "jobId": { "$ref": "#/$defs/identifier" },
        "decisionId": { "$ref": "#/$defs/identifier" },
        "code": { "$ref": "#/$defs/schedulerDeferredCode" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "nextEligibleAtMs": { "type": ["integer", "null"], "minimum": 0 },
        "routeDecisionId": { "$ref": "#/$defs/nullableIdentifier" }
      }
    },
    "schedulerStateChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jobId", "reason", "automatic"],
      "properties": {
        "jobId": { "$ref": "#/$defs/identifier" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "automatic": { "type": "boolean", "default": false }
      }
    },
    "schedulerLease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jobId",
        "dispatchId",
        "leaseId",
        "previousExpiresAtMs",
        "leaseExpiresAtMs",
        "reason"
      ],
      "properties": {
        "jobId": { "$ref": "#/$defs/identifier" },
        "dispatchId": { "$ref": "#/$defs/identifier" },
        "leaseId": { "$ref": "#/$defs/identifier" },
        "previousExpiresAtMs": { "type": "integer", "minimum": 0 },
        "leaseExpiresAtMs": { "type": "integer", "minimum": 0 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 2048 }
      }
    },
    "routeDecisionDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "policyId",
        "policyRevision",
        "evaluatedAtTimestampMs",
        "observedEventCount",
        "request",
        "selectedCandidateId",
        "selectedScoreBasisPoints",
        "estimatedCostMicrousd",
        "evaluatedCandidates",
        "eligibleCandidates",
        "homeLocked",
        "modelLocked",
        "sensitiveDirectory",
        "reasons",
        "rejectionSummary",
        "candidates"
      ],
      "properties": {
        "requestId": { "$ref": "#/$defs/identifier" },
        "policyId": { "$ref": "#/$defs/identifier" },
        "policyRevision": { "type": "integer", "minimum": 0 },
        "evaluatedAtTimestampMs": { "type": "integer", "minimum": 0 },
        "observedEventCount": { "type": "integer", "minimum": 0 },
        "request": { "$ref": "route-request.schema.json" },
        "selectedCandidateId": { "$ref": "#/$defs/nullableIdentifier" },
        "selectedScoreBasisPoints": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 10000
        },
        "estimatedCostMicrousd": { "type": ["integer", "null"], "minimum": 0 },
        "evaluatedCandidates": { "type": "integer", "minimum": 0 },
        "eligibleCandidates": { "type": "integer", "minimum": 0 },
        "homeLocked": { "type": "boolean" },
        "modelLocked": { "type": "boolean" },
        "sensitiveDirectory": { "type": "boolean" },
        "reasons": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 2048 }
        },
        "rejectionSummary": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 2048 }
        },
        "candidates": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/routeCandidateSnapshot" }
        }
      }
    },
    "routeCandidateSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId",
        "identity",
        "eligible",
        "totalScoreBasisPoints",
        "estimatedCostMicrousd",
        "historicalAttempts",
        "historicalSuccessBasisPoints",
        "activeAttempts",
        "quotaRemainingBasisPoints",
        "components",
        "reasons",
        "rejectionReasons"
      ],
      "properties": {
        "candidateId": { "$ref": "#/$defs/identifier" },
        "identity": { "$ref": "#/$defs/identity" },
        "eligible": { "type": "boolean" },
        "totalScoreBasisPoints": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 10000
        },
        "estimatedCostMicrousd": { "type": "integer", "minimum": 0 },
        "historicalAttempts": { "type": "integer", "minimum": 0 },
        "historicalSuccessBasisPoints": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "activeAttempts": { "type": "integer", "minimum": 0 },
        "quotaRemainingBasisPoints": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 10000
        },
        "components": {
          "type": "array",
          "items": { "$ref": "#/$defs/routeScoreSnapshot" }
        },
        "reasons": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 2048 }
        },
        "rejectionReasons": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 2048 }
        }
      }
    },
    "routeScoreSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "scoreBasisPoints",
        "weightBasisPoints",
        "weightedPoints",
        "reason"
      ],
      "properties": {
        "name": { "$ref": "#/$defs/label" },
        "scoreBasisPoints": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "weightBasisPoints": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "weightedPoints": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 2048 }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "secretsRedacted",
        "includesSecretValues",
        "readsAuthContents",
        "includesLocalPaths"
      ],
      "properties": {
        "secretsRedacted": { "const": true },
        "includesSecretValues": { "const": false },
        "readsAuthContents": { "const": false },
        "includesLocalPaths": { "type": "boolean" }
      }
    }
  }
}
