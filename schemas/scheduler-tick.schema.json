{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/harzva/codexhome-manager/schemas/scheduler-tick.schema.json",
  "title": "CodexHome Scheduler Tick",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ok",
    "schemaVersion",
    "evaluatedAtMs",
    "eventIds",
    "recoveryRequired",
    "automaticallyPaused",
    "safety"
  ],
  "properties": {
    "ok": { "const": true },
    "schemaVersion": { "const": "codexhome.scheduler-tick.v1" },
    "evaluatedAtMs": { "type": "integer", "minimum": 0 },
    "eventIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "observability-event.schema.json#/$defs/identifier" }
    },
    "recoveryRequired": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "observability-event.schema.json#/$defs/identifier" }
    },
    "automaticallyPaused": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "observability-event.schema.json#/$defs/identifier" }
    },
    "safety": { "$ref": "scheduler-report.schema.json#/$defs/safety" }
  }
}
