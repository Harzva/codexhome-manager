{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/harzva/codexhome-manager/schemas/scheduler-dispatch.schema.json",
  "title": "CodexHome Scheduler Dispatch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ok",
    "schemaVersion",
    "dispatched",
    "decision",
    "eventIds",
    "job",
    "safety"
  ],
  "properties": {
    "ok": { "type": "boolean" },
    "schemaVersion": { "const": "codexhome.scheduler-dispatch.v1" },
    "dispatched": { "type": "boolean" },
    "decision": {
      "oneOf": [
        { "$ref": "route-decision.schema.json" },
        { "type": "null" }
      ]
    },
    "eventIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "observability-event.schema.json#/$defs/identifier" }
    },
    "job": { "$ref": "scheduler-report.schema.json#/$defs/job" },
    "safety": { "$ref": "scheduler-report.schema.json#/$defs/safety" }
  }
}
