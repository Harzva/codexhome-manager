{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/harzva/codexhome-manager/schemas/registry.schema.json",
  "title": "CodexHome Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "revision", "homes"],
  "properties": {
    "schemaVersion": { "const": "codexhome.registry.v1" },
    "revision": { "type": "integer", "minimum": 0 },
    "homes": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "alias", "label", "path", "specialties", "origin"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-f0-9]{12}$" },
        "alias": { "type": "string", "pattern": "^@[a-z][a-z0-9-]{1,31}$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "path": { "type": "string", "minLength": 1 },
        "specialties": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 48 }
        },
        "origin": { "enum": ["created", "imported", "cloned"] },
        "derivedFrom": {
          "type": "string",
          "pattern": "^[a-f0-9]{12}$"
        }
      }
    }
  }
}
